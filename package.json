{
  "name": "mj-testing-playground",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "ng lint",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "serve:dist": "node e2e/serve-dist.mjs",
    "verify:fast": "bash .ai/harness/verify.sh fast",
    "verify": "bash .ai/harness/verify.sh full",
    "verify:smoke": "bash .ai/harness/verify.sh smoke",
    "verify:deep": "bash .ai/harness/verify.sh deep",
    "check-citations": "sh .ai/harness/check-citations.sh",
    "hook-test": "sh .ai/harness/hook-test.sh"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~21.2.24",
    "@angular/cli": "~21.2.24",
    "@angular/compiler-cli": "~21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.30.0",
    "@testing-library/dom": "^10.4.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.5",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.0",
    "jsdom": "^28.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2"
  }
}
