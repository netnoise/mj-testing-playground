{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/budget.mjs",
            "statusMessage": "harness: doors + budget"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "grep -lq '\"status\": *\"active\"' .ai/run/*/state.json 2>/dev/null && sh .ai/harness/handoff.sh >/dev/null 2>&1 || true",
            "statusMessage": "harness: handoff"
          }
        ]
      }
    ]
  }
}
